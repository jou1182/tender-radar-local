# حماية الملفات الثنائية من أي تحويل لنهايات الأسطر حتى تبقى البصمات ثابتة.
*.pdf binary
*.xlsx binary
*.docx binary
*.md text eol=lf

# P4-M0AMR — قواعد ضيقة للملفات النصية المولدة داخل benchmark فقط:
# تثبيت LF في checkouts المستقبلية حتى لا تتأثر حتمية إعادة التوليد بسياسة
# autocrlf لأي جهاز. لا تطال القواعد أي ملف ثنائي (PDF/XLSX/DOCX أعلاه).
benchmark/**/*.json text eol=lf
benchmark/**/*.txt text eol=lf

# P4-GITATTR0 — قاعدة محصورة بملفي runtime-freeze المبنيين أصلًا على LF:
# تثبيت LF لهذين الملفين فقط حتى لا تتأثر بصماتهما بسياسة autocrlf لأي جهاز.
# P4-GITATTR1 — وسّع القاعدة لتشمل كل scripts/lib/*.mjs بعد إعادة توليد بصمات
# runtime-freeze.json ضد المحتوى القانوني (Git blob، LF): المحتوى القانوني لم
# يتغيّر — فقط تمثيل نهايات الأسطر على القرص.
scripts/lib/*.mjs text eol=lf
