    {
      "parameters": {
        "jsCode": "// تلخيص نتيجة الخط الليلي — بلا أسرار ولا بيانات حساسة، loopback فقط.\nconst sync = $json ?? {};\nconst agents = $('قراءة حالة الطاقم والطوابير').first().json ?? {};\nconst activity = agents.activity ?? [];\nconst classifier = activity.find(a => a.agent_role_code === 'classifier');\nconst courier = activity.find(a => a.agent_role_code === 'courier');\nreturn [{\n  json: {\n    summary: 'اكتمل الخط الليلي',\n    checked: sync.checked ?? null,\n    added: Array.isArray(sync.added) ? sync.added.length : (sync.new_count ?? null),\n    changed: Array.isArray(sync.changed) ? sync.changed.length : (sync.changed_count ?? null),\n    classified: classifier ? JSON.parse(classifier.detail_json || '{}').classified : null,\n    queueRows: courier ? JSON.parse(courier.detail_json || '{}').rowsCreated : null,\n    waitingPurchase: courier ? JSON.parse(courier.detail_json || '{}').waitingPurchase : null,\n    generatedAt: new Date().toISOString(),\n  }\n}];"
      },
